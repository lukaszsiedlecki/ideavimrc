" ==========================================
" LEADER MAPPINGS - Bookmarks
" ==========================================

" --- Bookmarks (<leader>b) ---

" open the bookmarks popup (quick-switch list of all bookmarks)
nmap <leader>bm <Action>(Bookmarks)
" open the Bookmarks tool window's list view
nmap <leader>bs <Action>(ShowBookmarks)
" focus/open the Bookmarks tool window pane
nmap <leader>bt <Action>(ActivateBookmarksToolWindow)
" toggle a bookmark on the current line (add if absent, remove if present)
nmap <leader>bb <Action>(ToggleBookmark)
" edit the current line's bookmark (add a mnemonic/description) - creates one if it doesn't exist yet
nmap <leader>be <Action>(EditBookmark)
" jump to the previous bookmark (across the whole project)
nmap <leader>bp <Action>(GotoPreviousBookmark)
" jump to the next bookmark (across the whole project)
nmap <leader>bn <Action>(GotoNextBookmark)
let g:WhichKeyDesc_bookmarks = "<leader>b Bookmarks"
