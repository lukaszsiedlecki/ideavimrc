" ==========================================
" LEADER MAPPINGS - Display
" ==========================================

" --- Display (<leader>D) ---

" toggle Distraction-Free mode (hides all UI chrome except the editor itself)
nmap <leader>Dd <Action>(ToggleDistractionFreeMode)
" toggle Zen mode (Distraction-Free + fullscreen combined)
nmap <leader>Dz <Action>(ToggleZenMode)
" ToggleFullScreen (<leader>Df) removed - doesn't work under the COSMIC desktop
" environment (no known workaround), so it's not worth keeping in the file
let g:WhichKeyDesc_display = "<leader>D Display options"
let g:WhichKeyDesc_df_mode = "<leader>Dd Toggle Distraction-Free mode"
let g:WhichKeyDesc_zen_mode = "<leader>Dz Toggle Zen mode"

" ==========================================
" LEADER MAPPINGS - Information
" ==========================================

" --- Information (<leader>i) ---

" show the full error/warning description for the code under the cursor
nmap <leader>ie <Action>(ShowErrorDescription)
" show the inferred type of the expression under the cursor
nmap <leader>it <Action>(ExpressionTypeInfo)
" show parameter hints for the method call under the cursor
nmap <leader>ip <Action>(ParameterInfo)
" quick popup preview of the Javadoc/KDoc for the symbol under the cursor
nmap <leader>ij <Action>(QuickJavaDoc)
" show the current file's structure (methods/fields/classes) in a searchable popup
nmap <leader>if <Action>(FileStructurePopup)
" generate a UML diagram for the current class/package
nmap <leader>iU <Action>(ShowUmlDiagram)
" show the call hierarchy (who calls this / what this calls) for the symbol under the cursor
nmap <leader>ih <Action>(CallHierarchy)
" show all usages of the symbol under the cursor in a popup (quicker than full Find Usages)
nmap <leader>iu <Action>(ShowUsages)
" show the override hierarchy for the method under the cursor
nmap <leader>im <Action>(MethodHierarchy)
" show the class/interface inheritance hierarchy for the symbol under the cursor
nmap <leader>iy <Action>(TypeHierarchy)
" highlight every usage of the symbol under the cursor directly in the current file (no popup)
nmap <leader>iH <Action>(HighlightUsagesInFile)
" jump to the next usage highlighted by iH
nmap <leader>in <Action>(GotoNextElementUnderCaretUsage)
" jump to the previous usage highlighted by iH
nmap <leader>iN <Action>(GotoPrevElementUnderCaretUsage)
let g:WhichKeyDesc_info = "<leader>i Information"
let g:WhichKeyDesc_info_error = "<leader>ie Error Description"
let g:WhichKeyDesc_info_type = "<leader>it Expression Type"
let g:WhichKeyDesc_info_parameter = "<leader>ip Parameter Info"
let g:WhichKeyDesc_info_javadoc = "<leader>ij Java Doc"
let g:WhichKeyDesc_info_file_structure = "<leader>if File Structure"
let g:WhichKeyDesc_info_uml_diagram = "<leader>iU UML Diagram"
let g:WhichKeyDesc_info_call_hierarchy = "<leader>ih Call Hierarchy"
let g:WhichKeyDesc_info_show_usages = "<leader>iu Usages"
