" ==========================================
" LEADER MAPPINGS - Misc
" These are complete 2-key sequences, not group prefixes with sub-keys, so
" there's no top-level group label - just one WhichKeyDesc per mapping.
" ==========================================

" show the context menu (same as right-click) at the cursor position
nmap <leader>m <Action>(ShowPopupMenu)
" focus/open the built-in terminal tool window
nmap <leader>T <Action>(ActivateTerminalToolWindow)
" focus/open the Database tool window - capital B, to stay distinct from
" lowercase <leader>b (Bookmarks group above), matching the reference config
nmap <leader>B <Action>(ActivateDatabaseToolWindow)
" hide/show ALL open tool windows at once (Database, Terminal, Commit,
" Project, etc.) - this is a toggle, press again to bring them all back
nmap <leader>W <Action>(HideAllWindows)
let g:WhichKeyDesc_popup_menu = "<leader>m Show Popup Menu"
let g:WhichKeyDesc_terminal = "<leader>T Terminal"
let g:WhichKeyDesc_database = "<leader>B Database"
let g:WhichKeyDesc_hide_all_windows = "<leader>W Hide/Restore All Tool Windows"

" ==========================================
" LEADER MAPPINGS - IdeaVim config
" ==========================================

" --- IdeaVim (<leader>v) ---

" open ~/.ideavimrc directly in the editor for editing
nmap <leader>ve :e ~/.ideavimrc<CR>
" reload ~/.ideavimrc without needing :source - note some option types (like
" sethandler, notimeout) have needed a full IDE restart to fully take effect
" even when reloaded this way, per what we've hit earlier in this file
nmap <leader>vr <Action>(IdeaVim.ReloadVimRc.reload)
let g:WhichKeyDesc_vim = "<leader>v IdeaVim"
let g:WhichKeyDesc_vim_edit = "<leader>ve Edit ideavimrc"
let g:WhichKeyDesc_vim_reload = "<leader>vr Reload ideavimrc"

" ==========================================
" LEADER MAPPINGS - Case Conversion
" Requires the "Case Conversion" plugin from JetBrains Marketplace (plugin
" id me.laria.code.idea_caseconv). These are Visual-mode mappings (vmap),
" not Normal-mode (nmap), because they act on the current selection - there
" has to be a selection to convert.
" ==========================================

" --- Case Conversion (<leader>c, Visual mode) ---

" open a menu to pick which case conversion to apply to the selection
vmap <leader>cm <Action>(me.laria.code.idea_caseconv.convert_case_menu)
" convert selection to camelCase
vmap <leader>cc <Action>(me.laria.code.idea_caseconv.CamelCaseAction)
" convert selection to PascalCase
vmap <leader>cp <Action>(me.laria.code.idea_caseconv.PascalCaseAction)
" convert selection to snake_case
vmap <leader>cs <Action>(me.laria.code.idea_caseconv.SnakeCaseAction)
" convert selection to SCREAMING_SNAKE_CASE
vmap <leader>cS <Action>(me.laria.code.idea_caseconv.ScreamingSnakeCaseAction)
" convert selection to lowercase
vmap <leader>cl <Action>(me.laria.code.idea_caseconv.LowerCaseAction)
" convert selection to UPPERCASE
vmap <leader>cu <Action>(me.laria.code.idea_caseconv.UpperCaseAction)
" convert selection to dot.case
vmap <leader>c. <Action>(me.laria.code.idea_caseconv.DotCaseAction)
" convert selection to separate words (space-separated)
vmap <leader>cw <Action>(me.laria.code.idea_caseconv.SeparateWordsAction)
" convert selection to Title Case
vmap <leader>ct <Action>(me.laria.code.idea_caseconv.TitleCaseAction)
" convert selection to dash-case
vmap <leader>c- <Action>(me.laria.code.idea_caseconv.DashCaseAction)
" convert selection to Sentence case
vmap <leader>cd <Action>(me.laria.code.idea_caseconv.SentenceCaseAction)
let g:WhichKeyDesc_case_conversion = "<leader>c Case Conversion"
let g:WhichKeyDesc_change_case_menu = "<leader>cm Case Menu"
let g:WhichKeyDesc_case_conversion_camel = "<leader>cc camelCase"
let g:WhichKeyDesc_case_conversion_pascal = "<leader>cp PascalCase"
let g:WhichKeyDesc_case_conversion_snake = "<leader>cs snake_case"
let g:WhichKeyDesc_case_conversion_screaming_snake = "<leader>cS SCREAMING_SNAKE_CASE"
let g:WhichKeyDesc_case_conversion_lower = "<leader>cl lowercase"
let g:WhichKeyDesc_case_conversion_upper = "<leader>cu UPPERCASE"
let g:WhichKeyDesc_case_conversion_dot = "<leader>c. dot.case"
let g:WhichKeyDesc_case_conversion_words = "<leader>cw Separate Words"
let g:WhichKeyDesc_case_conversion_title = "<leader>ct Title Case"
let g:WhichKeyDesc_case_conversion_dash = "<leader>c- dash-case"
let g:WhichKeyDesc_case_conversion_sentence = "<leader>cd Sentence case"

" ==========================================
" LEADER MAPPINGS - Git (in-IDE)
" ==========================================

" --- Git (<leader>G) ---

" open the Commit tool window to stage and commit changes
nmap <leader>Gc <Action>(CheckinProject)
" push committed changes to the remote
nmap <leader>Gp <Action>(Vcs.Push)
" open the branch picker (checkout / create / merge branches)
nmap <leader>Gb <Action>(Git.Branches)
" show git blame annotations in the left margin of the current file
nmap <leader>Ga <Action>(Annotate)
" focus/open the Commit tool window (just switches focus, unlike Gc which starts a commit)
nmap <leader>Gt <Action>(ActivateCommitToolWindow)
" discard ALL uncommitted changes in the current file: selects the whole
" file first (gg V G), then rolls back everything in that selection - by
" itself, Vcs.RollbackChangedLines only reverts the single line the cursor
" is on, not the whole file, so the selection step is required
nmap <leader>Gr ggVG<Action>(Vcs.RollbackChangedLines)<Esc>
" discard uncommitted changes on ONLY the line the cursor is currently on -
" this is what Vcs.RollbackChangedLines does with no selection at all
nmap <leader>GR <Action>(Vcs.RollbackChangedLines)
" pull/update the project from the remote (git pull equivalent)
nmap <leader>Gu <Action>(Vcs.UpdateProject)
" fetch from the remote WITHOUT merging/rebasing (unlike Gu, which also updates the working copy)
nmap <leader>Gf <Action>(Git.Fetch)
" commit staged changes and push in one step (capital P to stay next to lowercase Gp = push-only)
nmap <leader>GP <Action>(Git.Commit.And.Push.Executor)
" open the current branch's pull request in the browser (GitHub only)
nmap <leader>Go <Action>(Github.View.Pull.Request)
" open the generic VCS actions popup menu (update, commit, push, branches, etc. in one list)
nmap <leader>Gm <Action>(VcsGroups)
" focus/open the Version Control tool window (the tabbed one with Log/Commit/etc. panes, distinct from Gt's Commit-only tool window)
nmap <leader>Gv <Action>(ActivateVersionControlToolWindow)
let g:WhichKeyDesc_git = "<leader>G Git"
let g:WhichKeyDesc_git_checkin = "<leader>Gc Commit"
let g:WhichKeyDesc_git_push = "<leader>Gp Push"
let g:WhichKeyDesc_git_branches = "<leader>Gb Branches"
let g:WhichKeyDesc_git_annotate = "<leader>Ga Annotate"
let g:WhichKeyDesc_git_tool_window = "<leader>Gt Focus Commit Tool Window"
let g:WhichKeyDesc_git_rollback = "<leader>Gr Rollback Whole File"
let g:WhichKeyDesc_git_rollback_line = "<leader>GR Rollback Current Line"
let g:WhichKeyDesc_git_fetch = "<leader>Gf Fetch"
let g:WhichKeyDesc_git_commit_and_push = "<leader>GP Commit And Push"
